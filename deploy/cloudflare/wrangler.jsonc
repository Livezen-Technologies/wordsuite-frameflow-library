{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "frameflow-library",
	"main": "worker.js",
	"compatibility_date": "2025-10-01",
	// The built admin + public site (npm --prefix ../../frontend run build). Everything that
	// isn't an API path is served from here, with index.html for client-side routes.
	"assets": {
		"directory": "../../frontend/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/feed/*", "/previews/*", "/healthz"]
	},
	"containers": [
		{
			// The Library API: CodeIgniter 4 on nginx + php-fpm (backend/Dockerfile).
			"class_name": "LibraryContainer",
			"image": "../../backend/Dockerfile",
			"image_build_context": "../../backend",
			"max_instances": 1,
			"instance_type": "standard-1"
		},
		{
			// Processing worker (apps/workers): FFmpeg + Chromium, polls the API for jobs.
			"class_name": "ProcessorContainer",
			"image": "../../apps/workers/Dockerfile",
			"image_build_context": "../..",
			"max_instances": 1,
			"instance_type": "standard-2"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "LIBRARY", "class_name": "LibraryContainer" },
			{ "name": "PROCESSOR", "class_name": "ProcessorContainer" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["LibraryContainer"] },
		{ "tag": "v2", "new_sqlite_classes": ["ProcessorContainer"] }
	],
	// Every 5 minutes: keep the processing worker running and the API awake (its
	// scheduler and webhook queue run inside the API container).
	"triggers": { "crons": ["*/5 * * * *"] },
	"vars": {
		"database.default.DBDriver": "Postgre",
		"LIBRARY_PUBLIC_URL": "https://library.frameflow.worksuitecloud.com"
	},
	// The worksuitecloud.com zone must be in the same Cloudflare account.
	"routes": [{ "pattern": "library.frameflow.worksuitecloud.com", "custom_domain": true }],
	"observability": { "enabled": true }
}
