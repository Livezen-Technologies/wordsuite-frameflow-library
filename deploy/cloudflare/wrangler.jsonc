{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "frameflow-library",
	"main": "worker.js",
	"compatibility_date": "2025-10-01",
	"containers": [
		{
			"class_name": "LibraryContainer",
			"image": "../../Dockerfile",
			"image_build_context": "../..",
			"max_instances": 1,
			"instance_type": "standard"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "LIBRARY", "class_name": "LibraryContainer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LibraryContainer"] }],
	// The worksuitecloud.com zone must be in the same Cloudflare account. The
	// web editor serves the rest of frameflow.worksuitecloud.com.
	"routes": [{ "pattern": "frameflow.worksuitecloud.com/library*", "zone_name": "worksuitecloud.com" }],
	"observability": { "enabled": true }
}
